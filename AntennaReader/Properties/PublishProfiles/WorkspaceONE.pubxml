<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for the Workspace ONE package.

  Visual Studio: right-click AntennaReader > Publish > WorkspaceONE > Publish.
  Terminal:      dotnet publish AntennaReader/AntennaReader.csproj -c Release -p:PublishProfile=WorkspaceONE

  Both produce the same result in deployment\out\ (see deployment\README.md):
    out\package\app\AntennaReader.exe           the published application
    out\AntennaReader-<version>-WorkspaceONE.zip  the file to upload to Workspace ONE

  Edit this file by hand rather than through the Publish settings dialog, so the comments survive.
-->
<Project>
  <PropertyGroup>
    <!-- Bump for every release and keep it equal to the git tag (v1.1.3 -> 1.1.3).
         Workspace ONE's detection rule compares against this version. -->
    <Version>1.1.3</Version>

    <!-- Same settings as .github/workflows/release.yml, so this build matches the GitHub release. -->
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Where everything goes. deployment\ sits next to the AntennaReader project folder. -->
    <DeploymentDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\deployment'))</DeploymentDir>
    <PackageDir>$(DeploymentDir)\out\package</PackageDir>
    <PackageZip>$(DeploymentDir)\out\AntennaReader-$(Version)-WorkspaceONE.zip</PackageZip>
    <PublishDir>$(PackageDir)\app\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- The logo. Only the published exe gets it; the code and normal builds are untouched. -->
    <ApplicationIcon>$(DeploymentDir)\AntennaReader.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Start from an empty package folder, so nothing left over from an earlier publish ends up in the zip. -->
  <Target Name="CleanWorkspaceOnePackage" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PackageDir)" Condition="'$(PackageDir)' != '' And Exists('$(PackageDir)')" />
  </Target>

  <!-- After publishing: put the install/uninstall scripts next to app\ and zip it all up. -->
  <Target Name="BuildWorkspaceOnePackage" AfterTargets="Publish">
    <Copy SourceFiles="$(DeploymentDir)\Install-AntennaReader.ps1;$(DeploymentDir)\Uninstall-AntennaReader.ps1"
          DestinationFolder="$(PackageDir)" />
    <!-- The zip has no folder at its root, so the Workspace ONE commands need no path prefix. -->
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <GetFileHash Files="$(PublishDir)AntennaReader.exe" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="ExeHash" />
    </GetFileHash>
    <Message Importance="high" Text="Workspace ONE package: $(PackageZip)" />
    <Message Importance="high" Text="AntennaReader.exe $(Version) SHA256: $(ExeHash)" />
  </Target>
</Project>
